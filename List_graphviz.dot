digraph G {

bgcolor = "#34252c"
node [shape = none];

node0 [label=<
	<TABLE BORDER = "1" CELLBORDER = "0" CELLSPACING = "0" CELLPADDING="4" STYLE = "ROUNDED"
	COLOR = "#260a18"
	BGCOLOR = "#77606b">
	<TR><TD COLSPAN = "2"><FONT COLOR = "#260a18">index = 0</FONT></TD></TR><HR/>
	<TR><TD COLSPAN = "2"><FONT COLOR = "#260a18">value = 67</FONT></TD></TR><HR/>
	<TR><TD><FONT COLOR = "#260a18">prev = 4</FONT></TD><VR/><TD><FONT COLOR = "#260a18">next = 2</FONT></TD></TR>
	</TABLE>
>];

node1 [label=<
	<TABLE BORDER = "1" CELLBORDER = "0" CELLSPACING = "0" CELLPADDING="4" STYLE = "ROUNDED"
	COLOR = "#430523"
	BGCOLOR = "#94285c">
	<TR><TD COLSPAN = "2"><FONT COLOR = "#260a18">index = 1</FONT></TD></TR><HR/>
	<TR><TD COLSPAN = "2"><FONT COLOR = "#260a18">value = 6</FONT></TD></TR><HR/>
	<TR><TD><FONT COLOR = "#260a18">prev = 2</FONT></TD><VR/><TD><FONT COLOR = "#260a18">next = 3</FONT></TD></TR>
	</TABLE>
>];

node2 [label=<
	<TABLE BORDER = "1" CELLBORDER = "0" CELLSPACING = "0" CELLPADDING="4" STYLE = "ROUNDED"
	COLOR = "#430523"
	BGCOLOR = "#ca80a2">
	<TR><TD COLSPAN = "2"><FONT COLOR = "#3f1229">index = 2</FONT></TD></TR><HR/>
	<TR><TD COLSPAN = "2"><FONT COLOR = "#3f1229">value = 7</FONT></TD></TR><HR/>
	<TR><TD><FONT COLOR = "#3f1229">prev = 0</FONT></TD><VR/><TD><FONT COLOR = "#3f1229">next = 1</FONT></TD></TR>
	</TABLE>
>];

node3 [label=<
	<TABLE BORDER = "1" CELLBORDER = "0" CELLSPACING = "0" CELLPADDING="4" STYLE = "ROUNDED"
	COLOR = "#430523"
	BGCOLOR = "#94285c">
	<TR><TD COLSPAN = "2"><FONT COLOR = "#260a18">index = 3</FONT></TD></TR><HR/>
	<TR><TD COLSPAN = "2"><FONT COLOR = "#260a18">value = 56</FONT></TD></TR><HR/>
	<TR><TD><FONT COLOR = "#260a18">prev = 1</FONT></TD><VR/><TD><FONT COLOR = "#260a18">next = 4</FONT></TD></TR>
	</TABLE>
>];

node4 [label=<
	<TABLE BORDER = "1" CELLBORDER = "0" CELLSPACING = "0" CELLPADDING="4" STYLE = "ROUNDED"
	COLOR = "#260a18"
	BGCOLOR = "#591837">
	<TR><TD COLSPAN = "2"><FONT COLOR = "#ca80a2">index = 4</FONT></TD></TR><HR/>
	<TR><TD COLSPAN = "2"><FONT COLOR = "#ca80a2">value = 12</FONT></TD></TR><HR/>
	<TR><TD><FONT COLOR = "#ca80a2">prev = 3</FONT></TD><VR/><TD><FONT COLOR = "#ca80a2">next = 0</FONT></TD></TR>
	</TABLE>
>];

node5 [label=<
	<TABLE BORDER = "1" CELLBORDER = "0" CELLSPACING = "0" CELLPADDING="4" STYLE = "ROUNDED"
	COLOR = "#063a2e"
	BGCOLOR = "#06a07c">
	<TR><TD COLSPAN = "2"><FONT COLOR = "#0a2920">index = 5</FONT></TD></TR><HR/>
	<TR><TD COLSPAN = "2"><FONT COLOR = "#0a2920">value = 67</FONT></TD></TR><HR/>
	<TR><TD><FONT COLOR = "#0a2920">prev = -1</FONT></TD><VR/><TD><FONT COLOR = "#0a2920">next = 0</FONT></TD></TR>
	</TABLE>
>];

{rank = same;node0; node1; node2; node3; node4; node5;}

node0 -> node1 [dir = forward, style = invis];
node1 -> node2 [dir = forward, style = invis];
node2 -> node3 [dir = forward, style = invis];
node3 -> node4 [dir = forward, style = invis];
node4 -> node5 [dir = forward, style = invis];

free [
	label = "free", shape = box, style = "rounded, filled",
	color = "#063a2e",
	fillcolor = "#06a07c",
	fontcolor = "#0a2920",
	group = "g1"
];

free -> node5 [dir = forward, style = invis, penwidth=2, color = "#06a07c"];

head [
	label = "head", shape = box, style = "rounded, filled",
	color = "#260a18",
	fillcolor = "#591837",
	fontcolor = "#ca80a2",
	group = "g1"
];

head -> node4 [dir = forward, style = invis, penwidth=2, color = "#591837"];

tail [
	label = "tail", shape = box, style = "rounded, filled",
	color = "#430523",
	fillcolor = "#ca80a2",
	fontcolor = "#3f1229",
	group = "g1"
];

tail -> node2 [dir = forward, style = invis, penwidth=2, color = "#ca80a2"];

node1 -> node2 [dir = forward, penwidth=2, color = "#591837", constraint = false];
node1 -> node3 [dir = forward, penwidth=2, color = "#ca80a2", constraint = false];

node2 -> node1 [dir = forward, penwidth=2, color = "#ca80a2", constraint = false];

node3 -> node1 [dir = forward, penwidth=2, color = "#591837", constraint = false];
node3 -> node4 [dir = forward, penwidth=2, color = "#ca80a2", constraint = false];

node4 -> node3 [dir = forward, penwidth=2, color = "#591837", constraint = false];


}
